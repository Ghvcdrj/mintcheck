# Copy this file to .env and fill in. NEVER commit .env to GitHub.

# Your Solami API key (https://solami.dev/signup). Free plan = RPC at 5 req/s.
# Blur decoded data (launch feed, trending, buy/sell pressure) needs the DataApi permission (Pro / Pro trial).
SOLAMI_API_KEY=

# Max RPC calls per second from this app. Free plan allows 5, keep 4 for safety.
RPC_RPS=4

# ONLY for local testing without a Solami key. Leave empty in production.
# RPC_URL=https://api.mainnet-beta.solana.com

# Optional Telegram alerts (python alerts.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_URL=http://127.0.0.1:8000
